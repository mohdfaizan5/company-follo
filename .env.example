# Hosted Neon PostgreSQL connection for application data and authentication.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Required by the Eve-powered CompanyFollo assistant in local development.
# Create a Vercel AI Gateway key before using /dashboard/assistant.
# AI_GATEWAY_API_KEY=""

# Required when document uploads are enabled.
# UPLOADTHING_TOKEN=""
# Paid UploadThing plans only: store employee documents as private files.
# UPLOADTHING_PRIVATE_FILES=true
